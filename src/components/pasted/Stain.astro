---
interface Props {
	kind?: 'ink' | 'coffee' | 'burn';
	side?: 'left' | 'right' | 'center';
	/** Size in pixels. */
	size?: number;
	rotate?: number;
}

const { kind = 'ink', side = 'right', rotate = 0 } = Astro.props;
const size = Astro.props.size ?? (kind === 'coffee' ? 150 : 90);
const id = `stain-${Math.random().toString(36).slice(2, 9)}`;
const seed = Math.floor(Math.random() * 100);
---

<span class:list={['stain', `side-${side}`]} style={`--size:${size}px;--rot:${rotate}deg`} aria-hidden="true">
	<svg viewBox="0 0 100 100">
		<filter id={id} x="-20%" y="-20%" width="140%" height="140%">
			<feTurbulence type="fractalNoise" baseFrequency={kind === 'coffee' ? 0.05 : 0.09} numOctaves="3" seed={seed} />
			<feDisplacementMap in="SourceGraphic" scale={kind === 'coffee' ? 6 : 16} />
		</filter>
		{
			kind === 'ink' && (
				<g filter={`url(#${id})`} fill="#1d1208" opacity="0.72">
					<circle cx="50" cy="50" r="17" />
					<circle cx="71" cy="38" r="4" />
					<circle cx="30" cy="68" r="3" />
					<circle cx="76" cy="62" r="2.2" />
					<circle cx="24" cy="36" r="1.6" />
					<ellipse cx="62" cy="72" rx="5" ry="2.5" />
				</g>
			)
		}
		{
			kind === 'coffee' && (
				<g filter={`url(#${id})`} fill="none" stroke="#6b3f17">
					<circle cx="50" cy="50" r="38" stroke-width="2.6" opacity="0.4" />
					<circle cx="50" cy="50" r="36" stroke-width="7" opacity="0.08" />
					<path d="M20 30 A 38 38 0 0 1 60 13" stroke-width="1.2" opacity="0.35" />
				</g>
			)
		}
		{
			kind === 'burn' && (
				<>
					<radialGradient id={`${id}-g`}>
						<stop offset="0" stop-color="#1a0b03" stop-opacity="0.85" />
						<stop offset="0.45" stop-color="#4a2208" stop-opacity="0.6" />
						<stop offset="0.8" stop-color="#8a5220" stop-opacity="0.2" />
						<stop offset="1" stop-color="#8a5220" stop-opacity="0" />
					</radialGradient>
					<circle cx="50" cy="50" r="40" fill={`url(#${id}-g)`} filter={`url(#${id})`} />
				</>
			)
		}
	</svg>
</span>
