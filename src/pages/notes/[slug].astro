---
import { render } from 'astro:content';
import BookLayout from '../../layouts/BookLayout.astro';
import Sheet from '../../components/Sheet.astro';
import Ornament from '../../components/Ornament.astro';
import Letter from '../../components/pasted/Letter.astro';
import { pasted } from '../../components/pasted';
import { published, url, initialOf } from '../../lib/book';

export async function getStaticPaths() {
	const notes = await published('notes');
	return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { title, kind, world_date, from, to, seal } = note.data;
const { Content } = await render(note);
---

<BookLayout title={title}>
	{
		kind === 'letter' && (
			<div class="on-the-desk" data-sheet>
				<h1 class="sr-only">{title}</h1>
				<Letter from={from} to={to} date={world_date} seal={seal} width="100%" tilt={-1}>
					<div class="prose">
						<Content components={pasted} />
					</div>
				</Letter>
			</div>
		)
	}

	{
		kind === 'diary' && (
			<Sheet>
				{world_date && <p class="kicker">{world_date}</p>}
				<h1 class="page-title">{title}</h1>
				<Ornament />
				<div class="prose dropcap" data-initial={initialOf(note.body)}>
					<Content components={pasted} />
				</div>
			</Sheet>
		)
	}

	{
		kind === 'fragment' && (
			<div class="on-the-desk" data-sheet>
				<div class="fragment">
					<div class="fragment-paper">
						<h1 class="fragment-title">{title}</h1>
						<div class="prose">
							<Content components={pasted} />
						</div>
						{from && <p class="fragment-from">— {from}</p>}
					</div>
				</div>
			</div>
		)
	}

	<p class="back"><a href={url('/notes')}>‹ Back to Notes & Letters</a></p>
</BookLayout>

<style>
	.on-the-desk {
		max-width: 40rem;
		margin: 2rem auto 0;
	}

	.fragment {
		filter: drop-shadow(0 12px 18px rgba(0, 0, 0, 0.55));
		transform: rotate(1.2deg);
	}

	.fragment-paper {
		padding: 2.4rem 2.2rem 3rem;
		color: #3b2a1a;
		background-color: #eadbb6;
		background-image:
			url('../../assets/textures/paper-grain.svg'),
			radial-gradient(ellipse at center, transparent 50%, rgba(110, 60, 15, 0.35));
		clip-path: polygon(2% 3%, 20% 0, 37% 2%, 55% 0, 78% 3%, 98% 0, 100% 22%, 97% 45%, 100% 70%, 98% 97%, 80% 100%, 62% 96%, 41% 100%, 22% 97%, 4% 100%, 0 78%, 3% 52%, 0 27%);
	}

	.fragment-title {
		margin: 0 0 1rem;
		font-family: var(--f-hand);
		font-weight: normal;
		font-size: 1.2rem;
		color: #7d2119;
	}

	.fragment-paper :global(.prose p) {
		text-align: left;
	}

	.fragment-from {
		margin: 1.2rem 0 0;
		text-align: right;
		font-family: var(--f-signature);
		font-size: 1.8rem;
	}

	.back {
		margin: 3rem 0 0;
		text-align: center;
		font-family: var(--f-smallcaps);
		letter-spacing: 0.08em;
	}

	.back a {
		color: var(--gold-light);
	}
</style>
